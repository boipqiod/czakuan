{
  "name": "czakuan-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "build:backend": "npm run build --workspace=apps/backend",
    "start": "npm run start --workspace=apps/backend",
    "lint": "npm run lint --workspaces",
    "migrate": "npm run migrate --workspace=apps/backend",
    "generate": "npm run generate --workspace=apps/backend",
    "migrate-and-generate": "npm run generate --workspace=apps/backend && npm run migrate --workspace=apps/backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  }
}
