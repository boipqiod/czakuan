generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              Int                @id @default(autoincrement())
  email           String?
  nickName        String             @unique
  profileImageUrl String?
  createdAt       DateTime           @default(now())
  deletedAt       DateTime?
  updatedAt       DateTime           @default(now()) @updatedAt
  name            String?
  phoneNumber     String?
  role            Role               @default(USER)
  kakaoId         BigInt             @unique
  Comment         Comment[]
  dislikeComment  DislikeToComment[]
  dislikePost     DislikeToPost[]
  likeComment     LikeToComment[]
  likePost        LikeToPost[]
  Post            Post[]
  reportComment   ReportToComment[]
  reportPost      ReportToPost[]
}

model CategoryGroup {
  id         Int        @id @default(autoincrement())
  name       String
  priority   Int        @default(0)
  isUse      Boolean    @default(false)
  categories Category[]
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String
  isUse         Boolean       @default(false)
  groupId       Int
  priority      Int           @default(0)
  group         CategoryGroup @relation(fields: [groupId], references: [id])
  posts         Post[]
  subCategories SubCategory[]
}

model SubCategory {
  id         Int      @id @default(autoincrement())
  name       String
  categoryId Int
  isUse      Boolean  @default(false)
  priority   Int      @default(0)
  posts      Post[]
  parent     Category @relation(fields: [categoryId], references: [id])
}

model Post {
  id            Int             @id @default(autoincrement())
  subCategoryId Int?
  title         String
  content       String
  thumbnailUrl  String?
  views         Int             @default(0)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime?       @updatedAt
  userId        Int
  images        String[]
  categoryId    Int
  isNotice      Boolean         @default(false)
  comments      Comment[]
  dislikes      DislikeToPost[]
  likes         LikeToPost[]
  category      Category        @relation(fields: [categoryId], references: [id])
  subCategory   SubCategory?    @relation(fields: [subCategoryId], references: [id])
  author        User            @relation(fields: [userId], references: [id])
  reports       ReportToPost[]
}

model LikeToPost {
  postId Int
  userId Int
  post   Post @relation(fields: [postId], references: [id])
  user   User @relation(fields: [userId], references: [id])

  @@id([userId, postId])
}

model DislikeToPost {
  postId Int
  userId Int
  post   Post @relation(fields: [postId], references: [id])
  user   User @relation(fields: [userId], references: [id])

  @@id([userId, postId])
}

model ReportToPost {
  postId Int
  userId Int
  reason String
  post   Post @relation(fields: [postId], references: [id])
  user   User @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@id([userId, postId])
}

model Comment {
  id        Int                @id @default(autoincrement())
  content   String
  parentId  Int?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  postId    Int
  userId    Int
  deletedAt DateTime?
  rootId    Int
  post      Post               @relation(fields: [postId], references: [id])
  author    User               @relation(fields: [userId], references: [id])
  parent    Comment?           @relation("CommentToParent", fields: [parentId], references: [id]) // 부모 관계
  children  Comment[]          @relation("CommentToParent") // 자식 관계
  
  dislikes  DislikeToComment[]
  likes     LikeToComment[]
  reports   ReportToComment[]

}

model LikeToComment {
  commentId Int
  userId    Int
  comment   Comment @relation(fields: [commentId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@id([userId, commentId])
}

model DislikeToComment {
  commentId Int
  userId    Int
  comment   Comment @relation(fields: [commentId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@id([userId, commentId])
}

model ReportToComment {
  commentId Int
  userId    Int
  reason    String
  comment   Comment @relation(fields: [commentId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@id([userId, commentId])
}

enum Role {
  SUPER_ADMIN
  BOARD_ADMIN
  USER
}
